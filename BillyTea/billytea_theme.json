{
  "name": "Billy Tea",
  "dataColors": [
    "#000000", "#E69F00", "#D55E00", "#009E73", "#56B4E9", "#CC79A7",
    "#2E7D32", "#B7791F", "#0072B2", "#F0E442",
    "#BDBDBD", "#9E9E9E", "#757575", "#616161", "#E0E0E0", "#C7C7C7", "#D6D6D6"
  ],
  "foreground": "#252423",
  "foregroundNeutralSecondary": "#605E5C",
  "foregroundNeutralTertiary": "#B3B0AD",
  "background": "#FFFFFF",
  "backgroundLight": "#F3F2F1",
  "backgroundNeutral": "#EDEBE9",
  "tableAccent": "#2E7D32",
  "maximum": "#D55E00",
  "center": "#E69F00",
  "minimum": "#009E73",
  "good": "#009E73",
  "neutral": "#E69F00",
  "bad": "#D55E00",
  "textClasses": {
    "title":     { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#252423" },
    "header":    { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#252423" },
    "label":     { "fontFace": "Segoe UI",          "fontSize": 10, "color": "#252423" },
    "callout":   { "fontFace": "Segoe UI",          "fontSize": 28, "color": "#252423" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border":     [{ "show": false }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#252423" } }, "fontSize": 13, "fontFamily": "Segoe UI Semibold", "alignment": "left" }],
        "visualHeader": [{ "show": true, "transparency": 100 }],
        "categoryAxis": [{ "gridlineShow": false, "titleFontSize": 10, "fontSize": 10, "labelColor": { "solid": { "color": "#605E5C" } } }],
        "valueAxis":    [{ "gridlineColor": { "solid": { "color": "#EDEBE9" } }, "gridlineThickness": 1, "titleFontSize": 10, "fontSize": 10, "labelColor": { "solid": { "color": "#605E5C" } } }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2, "showMarker": false }],
        "labels":     [{ "show": false }]
      }
    },
    "columnChart": { "*": { "labels": [{ "show": false }] } }
  }
}
